ENVIRONMENT=development

# Neon — pooled URL for the app, direct URL (host without "-pooler") for migrations
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# openssl rand -hex 32
JWT_SECRET=

# Production: .physionexs.com is not needed when the web app proxies /api (cookie stays first-party)
COOKIE_DOMAIN=
CORS_ORIGINS=["https://physionexs.com","https://www.physionexs.com","http://localhost:5173"]

# MSG91 (leave blank in dev: OTPs are printed to the API log)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI assist for physios (OpenAI). Leave the key blank to keep it off.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# WhatsApp check-ins (leave WHATSAPP_PROVIDER blank to keep them off; "log" in dev prints messages instead)
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Vercel Cron bearer secret
CRON_SECRET=

# Google sign-in (OAuth web client). Add each redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (password reset emails). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Physionexs <no-reply@physionexs.com>
